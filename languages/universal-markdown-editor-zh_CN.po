#. Plugin Name of the plugin
#: universal-markdown-editor.php
msgid "Universal Markdown Editor"
msgstr "Universal Markdown Editor"

#. Description of the plugin
#: universal-markdown-editor.php
msgid "Edit WordPress posts from a focused Markdown source workspace."
msgstr "在专注的 Markdown 源工作区中编辑 WordPress 文章。"

#: src/Post/SaveService.php:32
#: src/Post/SaveService.php:147
#: src/REST/MarkdownPreviewController.php:36
msgid "The requested post does not exist or is not supported."
msgstr "请求的文章不存在或不受支持。"

#: src/Post/SaveService.php:44
#: src/Post/SaveService.php:161
msgid "Markdown metadata is incomplete or unsupported. The post was not changed."
msgstr "Markdown 元数据不完整或不受支持。文章未被更改。"

#: src/Post/SaveService.php:66
msgid "This post uses incomplete or unsupported Markdown metadata. It was not changed."
msgstr "此文章使用了不完整或不受支持的 Markdown 元数据。文章未被更改。"

#: src/Post/SaveService.php:77
msgid "The saved Markdown and rendered content are inconsistent. Resolve the post before editing."
msgstr "已保存的 Markdown 与渲染内容不一致。编辑前请先处理此文章。"

#: src/Post/SaveService.php:108
#: src/REST/MarkdownPreviewController.php:69
msgid "Markdown source exceeds the 1 MiB limit."
msgstr "Markdown 源超过 1 MiB 限制。"

#: src/Post/SaveService.php:121
#: src/REST/MarkdownPreviewController.php:82
msgid "Markdown source is invalid."
msgstr "Markdown 源无效。"

#: src/Post/SaveService.php:122
#: src/REST/MarkdownPreviewController.php:83
msgid "Markdown could not be converted."
msgstr "Markdown 无法转换。"

#: src/Post/SaveService.php:183
msgid "The post changed after this editing session started. Reload or copy your Markdown before saving again."
msgstr "文章在本次编辑会话开始后发生了更改。请重新加载或在再次保存前复制你的 Markdown。"

#: src/Post/SaveService.php:192
msgid "The requested post no longer exists."
msgstr "请求的文章已不存在。"

#: src/Post/SaveService.php:202
msgid "The current post state could not be secured in a WordPress revision. No content was changed."
msgstr "无法在当前文章的 WordPress 修订版本中保护当前文章状态。内容未被更改。"

#: src/Post/SaveService.php:341
#: src/Post/SaveService.php:359
msgid "Another Markdown save is in progress. Keep your source and retry after it finishes."
msgstr "另一个 Markdown 保存正在进行。请保留你的源内容，并在其完成后重试。"

#: src/Post/SaveService.php:393
msgid "Markdown could not be saved. Previous post content and metadata were restored."
msgstr "Markdown 无法保存。之前的文章内容和元数据已恢复。"

#: src/Post/SaveService.php:394
msgid "Markdown could not be saved or safely restored. Stop editing this post and recover it from WordPress revisions."
msgstr "Markdown 无法保存或安全恢复。请停止编辑此文章，并从 WordPress 修订版本中恢复。"

#: src/REST/MarkdownDocumentController.php:80
msgid "The request must contain a Markdown source string and a valid editing baseline."
msgstr "请求必须包含 Markdown 源字符串和有效的编辑基线。"

#: src/REST/MarkdownPreviewController.php:46
msgid "You are not allowed to preview this post."
msgstr "你无权预览此文章。"

#: src/REST/MarkdownPreviewController.php:61
msgid "Markdown source must be a string."
msgstr "Markdown 源必须是字符串。"

#. translators: 1: minimum PHP version, 2: minimum WordPress version.
#: universal-markdown-editor.php:68
#, php-format
msgid "Universal Markdown Editor requires PHP %1$s or later and WordPress %2$s or later."
msgstr "Universal Markdown Editor 需要 PHP %1$s 或更高版本，以及 WordPress %2$s 或更高版本。"

#: universal-markdown-editor.php:89
msgid "Universal Markdown Editor dependencies are missing. Run composer install from the plugin directory."
msgstr "Universal Markdown Editor 缺少依赖项。请在插件目录中运行 composer install。"

